# Token de la Instagram Graph API. Solo en el servidor. No lo subas al repo.
IG_ACCESS_TOKEN=

# Contraseña única de la página. Elígela tú y pon la misma en Vercel.
APP_PASSWORD=

# Bearer de POST /api/ingest. Mínimo 32 caracteres. Sin él, esa ruta responde 401.
INGEST_TOKEN=

# Base Neon conectada desde el marketplace de Vercel. La integración inyecta este nombre.
DATABASE_URL=

# Blob privado. En Vercel basta BLOB_STORE_ID (OIDC). Fuera de Vercel, el token estático.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Copia estructurada en Notion. Token de una conexión interna y el id de la base.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Copia opcional de la imagen en Drive. Si faltan, no se intenta.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
DRIVE_FOLDER_ID=
